        <mxCell id="DWTWabbE8lqRN7Sj1fkF-185" parent="1" style="rounded=1;whiteSpace=wrap;html=1;roundedPerimeter=1;fillColor=light-dark(#FFFFFF,#FFCCFF);fontSize=29;fontColor=light-dark(#000000,#000000);fontStyle=1" value="Diagram ERD Kopma Sistim Penjualan dan Pembelian&amp;nbsp;&amp;nbsp;" vertex="1">
          <mxGeometry height="100" width="920" x="130" y="2600" as="geometry" />
        </mxCell>
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;erDiagram\n    petugas ||--o{ penjualan : \&quot;melayani\&quot;\n    anggota ||--o{ penjualan : \&quot;melakukan\&quot;\n    penjualan ||--o{ detail_penjualan : \&quot;memiliki\&quot;\n    barang ||--o{ detail_penjualan : \&quot;berisi\&quot;\n    pemasok ||--o{ pembelian : \&quot;menyuplai\&quot;\n    pembelian ||--o{ detail_pembelian : \&quot;memiliki\&quot;\n    barang ||--o{ detail_pembelian : \&quot;mengacu pada\&quot;\n\n    petugas {\n        INT id_petugas PK\n        CHAR_3 kode_petugas UK\n        VARCHAR_100 nama_petugas\n        ENUM peran_petugas\n    }\n\n    anggota {\n        INT id_anggota PK\n        CHAR_6 no_anggota UK\n        CHAR_10 nim_anggota UK\n        VARCHAR_100 nama_anggota\n        VARCHAR_60 prodi_anggota\n        VARCHAR_15 no_hp_anggota\n        ENUM status_anggota\n        DATE tgl_daftar_anggota\n    }\n\n    barang {\n        INT id_barang PK\n        VARCHAR_10 kode_barang UK\n        VARCHAR_100 nama_barang\n        ENUM kategori_barang\n        DECIMAL_12_2 harga_jual_barang\n        INT stok_barang\n        INT stok_min_barang\n    }\n\n    pemasok {\n        INT id_pemasok PK\n        VARCHAR_100 nama_pemasok\n        VARCHAR_15 telepon_pemasok\n        VARCHAR_200 alamat_pemasok\n    }\n\n    penjualan {\n        INT id_penjualan PK\n        CHAR_12 no_nota_penjualan UK\n        DATETIME tgl_penjualan\n        SMALLINT id_petugas FK\n        INT id_anggota FK\n        DECIMAL_12_2 bayar_penjualan\n    }\n\n    detail_penjualan {\n        INT id_penjualan PK_FK\n        INT id_barang PK_FK\n        SMALLINT qty_detail_penjualan\n        DECIMAL_12_2 harga_satuan_detail_penjualan\n    }\n\n    pembelian {\n        INT id_pembelian PK\n        VARCHAR_20 no_faktur_pembelian\n        DATE tgl_pembelian\n        INT id_pemasok FK\n        ENUM status_pembelian\n    }\n\n    detail_pembelian {\n        INT id_pembelian PK_FK\n        INT id_barang PK_FK\n        INT qty_detail_pembelian\n        DECIMAL_12_2 harga_beli_detail_pembelian\n    }\n\n    style petugas fill:#d0e1fd,stroke:#1565c0,stroke-width:2px;\n    style penjualan fill:#bbdefb,stroke:#0d47a1,stroke-width:2px;\n    style anggota fill:#d0e1fd,stroke:#1565c0,stroke-width:2px;\n    style pemasok fill:#f8bbd0,stroke:#c2185b,stroke-width:2px;\n    style detail_penjualan fill:#f48fb1,stroke:#880e4f,stroke-width:2px;\n    style barang fill:#e1bee7,stroke:#6a1b9a,stroke-width:2px;\n    style pembelian fill:#ffcc80,stroke:#e65100,stroke-width:2px;\n    style detail_pembelian fill:#f48fb1,stroke:#880e4f,stroke-width:2px;&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="DWTWabbE8lqRN7Sj1fkF-187">
