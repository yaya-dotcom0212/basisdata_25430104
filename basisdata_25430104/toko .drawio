        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;erDiagram\n    pengguna ||--o{ pesanan : \&quot;membuat\&quot;\n    kategori_produk ||--o{ produk : \&quot;mengkategorikan\&quot;\n    pesanan ||--o{ detail_pesanan : \&quot;memiliki\&quot;\n    produk ||--o{ detail_pesanan : \&quot;dipesan dalam\&quot;\n    pesanan ||--o{ pembayaran : \&quot;memiliki\&quot;\n    pesanan ||--o{ pengiriman_resi : \&quot;dikirim melalui\&quot;\n\n    pengguna {\n        INT id_pengguna PK\n        VARCHAR_100 nama_lengkap\n        VARCHAR_100 email_pengguna UK\n        VARCHAR_255 kata_sandi\n        VARCHAR_20 nomor_telepon\n        VARCHAR_20 peran_akses\n    }\n\n    banner_utama {\n        INT id_banner PK\n        VARCHAR_100 judul_banner\n        VARCHAR_255 gambar_banner\n        VARCHAR_255 tautan_promo\n        INT urutan_tampil\n    }\n\n    kategori_produk {\n        INT id_kategori PK\n        VARCHAR_100 nama_kategori\n        VARCHAR_255 deskripsi_kategori\n    }\n\n    produk {\n        INT id_produk PK\n        INT id_kategori FK\n        VARCHAR_150 nama_produk\n        VARCHAR_50 merek_produk\n        INT harga_produk\n        INT stok_produk\n        VARCHAR_500 deskripsi_produk\n        VARCHAR_255 gambar_utama\n        INT rating_produk\n    }\n\n    pesanan {\n        INT id_pesanan PK\n        INT id_pembeli FK\n        VARCHAR_25 tanggal_pesanan\n        INT total_bayar\n        VARCHAR_255 alamat_tujuan\n        VARCHAR_50 kota_kabupaten\n        VARCHAR_30 status_pesanan\n    }\n\n    detail_pesanan {\n        INT id_detail PK\n        INT id_pesanan FK\n        INT id_produk FK\n        INT jumlah_beli\n        INT subtotal_harga\n    }\n\n    pembayaran {\n        INT id_pembayaran PK\n        INT id_pesanan FK\n        VARCHAR_50 metode_pembayaran\n        VARCHAR_25 tanggal_pembayaran\n        INT jumlah_transfer\n        VARCHAR_255 bukti_pembayaran\n        VARCHAR_20 status_pembayaran\n    }\n\n    pengiriman_resi {\n        INT id_pengiriman PK\n        INT id_pesanan FK\n        VARCHAR_50 kurir_ekspedisi\n        VARCHAR_30 nomor_resi UK\n        VARCHAR_25 tanggal_dikirim\n        VARCHAR_25 tanggal_diterima\n        VARCHAR_100 nama_penerima\n        VARCHAR_255 bukti_paket_sampai\n        VARCHAR_30 status_pengiriman\n    }\n\n    style pengguna fill:#d0e1fd,stroke:#1565c0,stroke-width:2px;\n    style pesanan fill:#bbdefb,stroke:#0d47a1,stroke-width:2px;\n    style pembayaran fill:#ffcc80,stroke:#e65100,stroke-width:2px;\n    style pengiriman_resi fill:#f8bbd0,stroke:#c2185b,stroke-width:2px;\n    style detail_pesanan fill:#f48fb1,stroke:#880e4f,stroke-width:2px;\n    style produk fill:#e1bee7,stroke:#6a1b9a,stroke-width:2px;\n    style kategori_produk fill:#d0e1fd,stroke:#1565c0,stroke-width:2px;\n    style banner_utama fill:#e0f2f1,stroke:#00695c,stroke-width:2px;&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="_iiK49fCNRqR45mN5iS6-365">
